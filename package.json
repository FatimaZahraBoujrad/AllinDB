{
  "name": "allindb",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first PostgreSQL developer workspace",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm run start:dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:api": "npm run start:dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace backend",
    "check": "npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
